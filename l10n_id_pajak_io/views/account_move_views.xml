<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_pajak_io" model="ir.ui.view">
        <field name="name">account.move.form.pajak.io</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Pajak.io action buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_pajak_io_submit"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-send"
                    invisible="move_type != 'out_invoice' or state != 'posted' or pajak_io_status not in ['not_submitted', 'rejected']"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Submit</span>
                        <span class="o_stat_text">Pajak.io</span>
                    </div>
                </button>
                <button
                    name="action_pajak_io_cancel"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-times-circle"
                    invisible="move_type != 'out_invoice' or pajak_io_status not in ['approved']"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Batal</span>
                        <span class="o_stat_text">Pajak.io</span>
                    </div>
                </button>
                <button
                    name="action_pajak_io_refresh_status"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-refresh"
                    invisible="move_type != 'out_invoice' or pajak_io_status == 'not_submitted'"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Refresh</span>
                        <span class="o_stat_text">Status</span>
                    </div>
                </button>
                <button
                    name="action_pajak_io_download_pdf"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-pdf-o"
                    invisible="move_type != 'out_invoice' or pajak_io_status not in ['approved', 'cancelled']"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">PDF</span>
                        <span class="o_stat_text">e-Faktur</span>
                    </div>
                </button>
            </xpath>

            <!-- Pajak.io tab in the notebook -->
            <xpath expr="//notebook" position="inside">
                <page
                    string="Pajak.io"
                    name="pajak_io"
                    invisible="move_type != 'out_invoice'"
                >
                    <group>
                        <group string="Status Pajak.io">
                            <field name="pajak_io_status" />
                            <field name="pajak_io_transaction_id" />
                            <field name="pajak_io_no_faktur" />
                        </group>
                        <group string="Pengaturan Faktur">
                            <field name="l10n_id_kode_transaksi" />
                            <field name="l10n_id_termin_pembayaran" />
                            <field
                                name="l10n_id_coretax_add_info_07"
                                invisible="l10n_id_kode_transaksi != '07'"
                            />
                            <field
                                name="l10n_id_coretax_add_info_08"
                                invisible="l10n_id_kode_transaksi != '08'"
                            />
                            <field
                                name="l10n_id_coretax_custom_doc"
                                invisible="l10n_id_kode_transaksi not in ['07', '08']"
                            />
                            <field
                                name="l10n_id_replace_invoice_id"
                                invisible="l10n_id_kode_transaksi not in ['07', '08']"
                            />
                        </group>
                    </group>
                    <separator string="Riwayat Transaksi Pajak.io" />
                    <field name="pajak_io_transaction_ids" readonly="1">
                        <list>
                            <field name="transaction_id" />
                            <field name="no_faktur" />
                            <field name="transaction_status" />
                            <field name="invoice_status" />
                            <field name="is_replacement" />
                            <field name="submitted_at" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
