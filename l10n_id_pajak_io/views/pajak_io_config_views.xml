<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_pajak_io_config_form" model="ir.ui.view">
        <field name="name">l10n.id.pajak.io.config.form</field>
        <field name="model">l10n.id.pajak.io.config</field>
        <field name="arch" type="xml">
            <form string="Konfigurasi Pajak.io">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nama Konfigurasi..." />
                        </h1>
                    </div>
                    <group>
                        <group string="Koneksi API">
                            <field name="company_id" />
                            <field name="environment" />
                            <field name="api_key" password="True" />
                            <field name="request_timeout" />
                        </group>
                        <group string="Pengaturan">
                            <field name="auto_upload_djp" />
                            <field name="logging_enabled" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pajak_io_config_list" model="ir.ui.view">
        <field name="name">l10n.id.pajak.io.config.list</field>
        <field name="model">l10n.id.pajak.io.config</field>
        <field name="arch" type="xml">
            <list string="Konfigurasi Pajak.io">
                <field name="name" />
                <field name="company_id" />
                <field name="environment" />
                <field name="auto_upload_djp" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="action_pajak_io_config" model="ir.actions.act_window">
        <field name="name">Konfigurasi Pajak.io</field>
        <field name="res_model">l10n.id.pajak.io.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_pajak_io_config"
        name="Pajak.io"
        parent="account.menu_finance_configuration"
        action="action_pajak_io_config"
        sequence="90"
    />
</odoo>
