<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_pajak_io_cancel_wizard_form" model="ir.ui.view">
        <field name="name">l10n.id.pajak.io.cancel.wizard.form</field>
        <field name="model">l10n.id.pajak.io.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Batalkan Invoice di Pajak.io">
                <group>
                    <field name="move_id" readonly="1" />
                    <field name="transaction_id" readonly="1" />
                    <field name="no_faktur" readonly="1" />
                    <field name="transaction_status" readonly="1" />
                </group>
                <div class="alert alert-warning" role="alert">
                    Jika pembeli sudah mengkreditkan faktur ini, pembatalan memerlukan
                    persetujuan dari pihak pembeli. Status akan berubah menjadi
                    <strong>Menunggu Pembatalan</strong>. Gunakan tombol
                    <strong>Refresh Status</strong> pada invoice untuk memperbarui statusnya.
                </div>
                <footer>
                    <button
                        name="action_cancel"
                        string="Batalkan Faktur"
                        type="object"
                        class="btn-danger"
                    />
                    <button string="Tutup" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
