<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_pajak_io_test_connection_form" model="ir.ui.view">
        <field name="name">l10n.id.pajak.io.test.connection.form</field>
        <field name="model">l10n.id.pajak.io.test.connection</field>
        <field name="arch" type="xml">
            <form string="Test Koneksi Pajak.io">
                <group>
                    <field name="config_id" readonly="1" />
                    <field name="status" readonly="1" widget="statusbar" />
                    <field name="message" readonly="1" />
                </group>
                <footer>
                    <button
                        name="action_test"
                        string="Test Koneksi"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Tutup" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
